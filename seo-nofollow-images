// Añadir rel="nofollow" a enlaces de imágenes en el contenido
function add_nofollow_to_image_links($content) {
    if (!empty($content)) {
        $dom = new DOMDocument();
        @$dom->loadHTML('<?xml encoding="utf-8" ?>' . $content);
        
        $links = $dom->getElementsByTagName('a');
        
        foreach ($links as $link) {
            $has_image = false;
            foreach ($link->getElementsByTagName('img') as $img) {
                $has_image = true;
                break;
            }
            
            if ($has_image) {
                $rel = $link->getAttribute('rel');
                if (empty($rel)) {
                    $link->setAttribute('rel', 'nofollow');
                } elseif (strpos($rel, 'nofollow') === false) {
                    $link->setAttribute('rel', "$rel nofollow");
                }
            }
        }
        
        $body = $dom->getElementsByTagName('body')->item(0);
        $content = '';
        foreach ($body->childNodes as $node) {
            $content .= $dom->saveHTML($node);
        }
        
        return $content;
    }
    return $content;
}
add_filter('the_content', 'add_nofollow_to_image_links', 20);

