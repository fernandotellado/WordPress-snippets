// Añadir rel="nofollow" a enlaces de imágenes en el contenido
function ayudawp_nofollow_enlaces_imagenes($content) {
    // Usamos DOMDocument para parsear el HTML de forma segura
    if (!empty($content)) {
        $dom = new DOMDocument();
        // Suprimimos warnings por HTML5 no válido
        @$dom->loadHTML('<?xml encoding="utf-8" ?>' . $content);
        
        // Buscamos todos los enlaces <a> que contengan imágenes
        $links = $dom->getElementsByTagName('a');
        
        foreach ($links as $link) {
            // Verificamos si el enlace contiene una imagen
            $has_image = false;
            foreach ($link->getElementsByTagName('img') as $img) {
                $has_image = true;
                break;
            }
            
            if ($has_image) {
                // Obtenemos el atributo rel existente
                $rel = $link->getAttribute('rel');
                
                // Si no tiene rel o no contiene nofollow, lo añadimos
                if (empty($rel)) {
                    $link->setAttribute('rel', 'nofollow');
                } elseif (strpos($rel, 'nofollow') === false) {
                    $link->setAttribute('rel', "$rel nofollow");
                }
            }
        }
        
        // Extraemos solo el contenido del body
        $body = $dom->getElementsByTagName('body')->item(0);
        $content = '';
        foreach ($body->childNodes as $node) {
            $content .= $dom->saveHTML($node);
        }
        
        return $content;
    }
    return $content;
}

// Aplicamos el filtro al contenido
add_filter('the_content', 'ayudawp_nofollow_enlaces_imagenes', 20);

// Añadir rel="nofollow" a galerías de WordPress
function ayudawp_nofollow_enlaces_galerias($output, $attr, $instance) {
    // Procesamos la salida de la galería
    if (!empty($output)) {
        $dom = new DOMDocument();
        @$dom->loadHTML('<?xml encoding="utf-8" ?>' . $output);
        
        $links = $dom->getElementsByTagName('a');
        
        foreach ($links as $link) {
            $rel = $link->getAttribute('rel');
            if (empty($rel)) {
                $link->setAttribute('rel', 'nofollow');
            } elseif (strpos($rel, 'nofollow') === false) {
                $link->setAttribute('rel', "$rel nofollow");
            }
        }
        
        $body = $dom->getElementsByTagName('body')->item(0);
        $output = '';
        foreach ($body->childNodes as $node) {
            $output .= $dom->saveHTML($node);
        }
    }
    return $output;
}
add_filter('post_gallery', 'ayudawp_nofollow_enlaces_galerias', 10, 3);

// Añadir rel="nofollow" al insertar imágenes en el editor
function ayudawp_nofollow_enlaces_imagenes_editor($html, $id, $caption, $title, $align, $url, $size, $alt) {
    if ($url) {
        // Si ya tiene rel="nofollow" no lo modificamos
        if (strpos($html, 'rel="nofollow"') === false) {
            $html = str_replace('<a ', '<a rel="nofollow" ', $html);
        }
    }
    return $html;
}
add_filter('image_send_to_editor', 'ayudawp_nofollow_enlaces_imagenes_editor', 10, 8);

// Soporte para el editor de bloques (Gutenberg)
function ayudawp_nofollow_imagenes_bloques($block_content, $block) {
    if (!empty($block_content) && 
        (isset($block['blockName']) && 
        ($block['blockName'] === 'core/image' || $block['blockName'] === 'core/gallery'))
    ) {
        $dom = new DOMDocument();
        @$dom->loadHTML('<?xml encoding="utf-8" ?>' . $block_content);
        
        $links = $dom->getElementsByTagName('a');
        
        foreach ($links as $link) {
            $rel = $link->getAttribute('rel');
            if (empty($rel)) {
                $link->setAttribute('rel', 'nofollow');
            } elseif (strpos($rel, 'nofollow') === false) {
                $link->setAttribute('rel', "$rel nofollow");
            }
        }
        
        $body = $dom->getElementsByTagName('body')->item(0);
        $output = '';
        foreach ($body->childNodes as $node) {
            $output .= $dom->saveHTML($node);
        }
        return $output;
    }
    return $block_content;
}
add_filter('render_block', 'ayudawp_nofollow_imagenes_bloques', 10, 2);
